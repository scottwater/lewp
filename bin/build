#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

pkg="github.com/scottwater/lewp/internal/buildinfo"

# Compile time changes on every build so `lewp version --detailed` reflects this build.
build_date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
version="${LEWP_VERSION:-$(git describe --tags --always --dirty 2>/dev/null || echo dev)}"
commit="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

ldflags="-X ${pkg}.Version=${version} -X ${pkg}.Commit=${commit} -X ${pkg}.Date=${build_date}"

go build -trimpath -ldflags "${ldflags}" -o lewp ./cmd/lewp
echo "$repo_root/lewp"
